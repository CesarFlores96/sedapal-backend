DATABASE_URL=postgresql://app_user:CHANGE_ME@127.0.0.1:5432/bd_facturacion_local
API_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
GIS_DATABASE_URL=
MARTIN_DATABASE_URL=

# Supabase queda limitado a Auth y al pool allowlisted de supervision/planillas.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_JWT_SECRET=CHANGE_ME
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_DATABASE_URL=postgresql://restricted_role:CHANGE_ME@HOST:5432/postgres
PRIVATE_FILES_ROOT=D:\BD_LOCAL\private-files
UPDATER_RELEASES_DIR=D:\BD_LOCAL\sedapalgis-releases
UPDATER_PUBLIC_BASE_URL=https://api.sedapal.lat
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://sedapal.lat,https://www.sedapal.lat,https://sedapal-lat.vercel.app
ALLOWED_ORIGIN_REGEX=^https://[a-z0-9-]+-cesarflores\.vercel\.app$

# Servidor propio de OTA (Expo Updates protocol). La clave privada NUNCA debe
# vivir dentro de un repo git; generarla con "npx expo-updates codesigning:generate"
# y apuntar aqui a su ruta en disco (ver plan/documentacion de OTA).
OTA_SIGNING_PRIVATE_KEY_PATH=D:\BD_LOCAL\ota-keys\private-key.pem
OTA_PUBLIC_BASE_URL=https://api.sedapal.lat
